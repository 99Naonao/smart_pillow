/* 与 status 页「功能区域」.card-grid 配色一致 */
.tab-bar {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	height: 160rpx;
	background: linear-gradient(180deg, #083969 0%, #005578 100%);
	border-top: 1rpx solid rgba(175, 160, 201, 0.45);
	box-shadow: 0 -4rpx 20rpx rgba(5, 28, 44, 0.18);
	display: flex;
	padding-bottom: env(safe-area-inset-bottom);
	box-sizing: border-box;
}

.tab-bar-border {
	/* background-color: rgba(0, 0, 0, 0.33); */
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 1px;
	transform: scaleY(0.5);
}

.tab-bar-item {
	flex: 1;
	text-align: center;
	display: flex;
	justify-content: center;
	align-items: center;
	flex-direction: column;
}

/* 选中/未选中共用同一尺寸，比例由 aspectFit 保持，禁止横向拉伸 */
.tab-bar-icon {
	width: 48rpx;
	height: 48rpx;
	flex-shrink: 0;
	display: block;
}

.tab-bar-text {
	font-size: 22rpx;
	margin-top: 6rpx;
	line-height: 1.2;
}